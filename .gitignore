# --- local secrets (Groq / hosted-backend key for running the demo locally) ---
.env.local

# --- python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# --- the source document (copyright) ---
# The prospectus is a third-party copyrighted PDF and is not redistributed here. Place your own
# copy under data/raw/ (see data/raw/README.md) and build the index with `scripts.build_index`.
data/raw/*.pdf

# --- generated artifacts (rebuild with `python -m scripts.build_index`) ---
# chunks.jsonl is the extracted policy text; the FAISS + BM25 indexes are derived from it. These
# are now COMMITTED (they total under 1 MB) so the free hosted demo can clone a ready-to-serve
# index without the source PDF, which stays out of the repo for copyright. Rebuild locally any
# time with `python -m scripts.build_index`.

# --- generated eval output (rebuild with `python -m scripts.evaluate`) ---
# The measured numbers are in the README; this is the full per-question dump behind them.
eval/results.json

# --- local editor / tooling config ---
.claude/

# --- personal Wix / blog drafts, not repo documentation ---
writing/
